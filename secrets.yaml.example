# Template for secrets.yaml, which is gitignored and never committed.
#
# Copy this file to secrets.yaml and fill in real values for local/live use:
#   cp secrets.yaml.example secrets.yaml
#
# CI and any local `esphome config` / config-check runs use this file
# (via a copy to secrets.yaml) with these dummy values instead of real
# credentials, since check_config and esphome config only need the keys
# to resolve, not real secrets, to validate YAML/schema correctness.
#
# Note: ESPHome resolves !secret relative to each *.yaml file's own
# directory, not the repo root -- so for esphome/*.yaml this file needs
# to be copied to esphome/secrets.yaml specifically (the esphome-config
# pre-commit hook and the CI workflow both do this automatically).
#
# Keep this file's key set in sync with every `!secret <key>` reference
# in the repo. The pre-commit "secrets drift" hook enforces this.

abode_alarm_code: "0000"
api_key: "ZY/z6DU12PoXtOTVh8MO64SbnhBRCqgjX/Kt99Qrya8="  # dummy 32-byte base64 key (ESPHome api encryption requires valid base64)
home_elevation: 0
home_latitude: 0.0
home_longitude: 0.0
internal_url: "http://homeassistant.local:8123"
ota_password: "dummy_ota_password"
wifi_ap_password: "dummy_ap_password"
wifi_password: "dummy_wifi_password"
wifi_ssid: "dummy_ssid"
